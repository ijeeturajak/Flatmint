# Flatmint Environment Variables
# Copy to .env.local and populate with your Supabase project credentials.

# Supabase API URL (Found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Client Key (Public Safe Key)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Application Configuration
VITE_APP_NAME=Flatmint
VITE_APP_TAGLINE="Find Your People. Find Your Space."
VITE_DEFAULT_CITY=Bengaluru
VITE_DEFAULT_CURRENCY=INR
VITE_ENABLE_MOCK_FALLBACK=true

